# Frontend environment. Copy to .env.local for local development.
#
# NOTHING SECRET BELONGS IN THIS FILE. The frontend is presentation-only
# (constraint C3): no database URL, no API keys, no ADMIN_PASSWORD, no
# SESSION_SECRET.

# Base URL of the backend REST API (no trailing slash). SERVER-ONLY — note the
# absence of a NEXT_PUBLIC_ prefix: this value is used by next.config.ts (the
# /api/backend/* proxy rewrite + CSP) and by lib/backend.ts's server branch
# (ISR/SSR). It is NEVER shipped to the browser bundle. Browser-side calls go
# to the same-origin path /api/backend/*, which Vercel rewrites to this URL
# server-side — that is what makes the admin session cookie first-party
# (constraint C4b; docs/architecture.md §13).
#   local:      http://localhost:4000
#   production: the backend's own Vercel URL, e.g. https://<backend>.vercel.app
BACKEND_URL=http://localhost:4000

# This site's own canonical URL, for metadata / OG / sitemap. Optional locally.
# Public (browser-visible) by design — it is just this site's address.
#   production: https://<your-domain>
NEXT_PUBLIC_SITE_URL=
