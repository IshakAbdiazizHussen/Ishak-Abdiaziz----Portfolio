# Backend environment. Copy to .env for local development.
# NOTHING in here is optional at the "it still boots" level unless marked so:
# missing/malformed required vars cause the process to exit at startup (fail fast).
# A present-but-unreachable Postgres/Redis does NOT fail fast — /health reports it.

# --- Runtime ---
NODE_ENV=development
PORT=4000
# Number of reverse-proxy hops to trust for req.ip. Railway = 1. NEVER "true".
TRUST_PROXY_HOPS=1

# --- Data stores (required) ---
DATABASE_URL=
REDIS_URL=

# --- Admin auth (required) ---
# The single shared admin password. Use something long and unique.
ADMIN_PASSWORD=
# Signs the session cookie. >= 32 chars of random.
SESSION_SECRET=
# Session lifetime in seconds; TTL slides forward on each authed request.
SESSION_TTL_SECONDS=604800
# Shared parent domain for the sid cookie, e.g. .ishak.dev
# Leave BLANK locally so the cookie defaults to localhost.
COOKIE_DOMAIN=

# --- CORS (required) ---
# Comma-separated EXACT origins. Never "*".
CORS_ALLOWED_ORIGINS=http://localhost:3000

# --- Log cache ---
LOG_CACHE_TTL_SECONDS=45

# --- Image storage (required once the upload endpoint is used) ---
BLOB_READ_WRITE_TOKEN=
# Comma-separated allowed hosts for stored image URLs. A leading-dot-free host
# also matches its subdomains (Vercel Blob serves from <id>.public.blob.vercel-storage.com).
BLOB_ALLOWED_HOSTS=blob.vercel-storage.com

# --- Email / contact form (required) ---
# Resend API key. Get one free at resend.com.
RESEND_API_KEY=
# Where contact-form messages are delivered.
CONTACT_TO_EMAIL=
# Verified sender. For quick local testing you can use onboarding@resend.dev.
CONTACT_FROM_EMAIL=
