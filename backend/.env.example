# Backend environment. Copy to .env for local development.
# NOTHING in here is optional at the "it still boots" level unless marked so:
# missing/malformed required vars cause the process to exit at startup (fail fast).
# A present-but-unreachable Postgres/Redis does NOT fail fast — /health reports it.

# --- Runtime ---
NODE_ENV=development
PORT=4000
# Reverse-proxy hops to trust for req.ip. 0 = trust nothing (local dev).
# Set to 1 on Railway (exactly one proxy hop). NEVER a value that trusts all.
TRUST_PROXY_HOPS=0

# --- Data stores (required) ---
DATABASE_URL=
REDIS_URL=

# --- Admin auth (required) ---
# The single shared admin password. Use something long and unique.
ADMIN_PASSWORD=
# Signs the session cookie. >= 32 chars of random.
SESSION_SECRET=
# Session lifetime in seconds; TTL slides forward on each authed request.
SESSION_TTL_SECONDS=604800
# Shared parent domain for the sid cookie, e.g. .ishak.dev
# Leave BLANK locally so the cookie defaults to localhost.
COOKIE_DOMAIN=

# --- CORS (required) ---
# Comma-separated EXACT origins. Never "*".
#   local:      http://localhost:3000
#   production: https://<domain>,https://www.<domain>
CORS_ALLOWED_ORIGINS=http://localhost:3000
# Optional. A tightly-anchored regex; a matching Origin is allowed through CORS
# so the PUBLIC endpoints (GET /api/log, POST /api/contact) work on Vercel
# preview URLs. Admin still won't work on a preview (cross-site cookie). Leave
# blank unless you need it. Example:
#   ^https://portfolio-[a-z0-9-]+\.vercel\.app$
CORS_PREVIEW_ORIGIN_REGEX=

# --- Log cache ---
LOG_CACHE_TTL_SECONDS=45

# --- File storage (Log/content uploads: images + PDF) ---
# Set a real Vercel Blob token for any deployed instance. Leave it BLANK for
# local development and uploads are written to backend/uploads/ and served at
# http://localhost:<PORT>/uploads/... instead (no external account needed).
BLOB_READ_WRITE_TOKEN=
# Only needed if the backend is reached at something other than
# http://localhost:<PORT> while using the local storage driver.
PUBLIC_BASE_URL=
# Comma-separated allowed hosts for stored image URLs. A leading-dot-free host
# also matches its subdomains (Vercel Blob serves from <id>.public.blob.vercel-storage.com).
BLOB_ALLOWED_HOSTS=blob.vercel-storage.com

# --- Email / contact form (required) ---
# Resend API key. Get one free at resend.com.
RESEND_API_KEY=
# Where contact-form messages are delivered.
CONTACT_TO_EMAIL=
# Verified sender. For quick local testing you can use onboarding@resend.dev.
CONTACT_FROM_EMAIL=
